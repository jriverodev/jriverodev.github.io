# Example .env for the sign-upload service
# Copy to .env and fill with your values (do NOT commit service_role key to public repos)

SUPABASE_URL=https://your-project.supabase.co
SERVICE_ROLE_KEY=eyJ... (service_role key - keep secret)
# Optional simple API key for the sign endpoint (server-side shared secret)
SIGN_UPLOAD_API_KEY=your-api-key-here
# Optional JWT secret used to validate Bearer tokens (HMAC)
SIGN_UPLOAD_JWT_SECRET=your-jwt-secret-here
PORT=3000
